{
    "multipart": [
        {   "when": { "axis": "z"                  }, "apply": { "model": "soviet:block/structural/steel_pylon_horizontal",                            "uvlock": true } },
        {   "when": { "axis": "z", "down":  "true" }, "apply": { "model": "soviet:block/structural/steel_pylon_horizontal_down",                       "uvlock": true } },
        {   "when": { "axis": "z", "east":  "true" }, "apply": { "model": "soviet:block/structural/steel_pylon_horizontal_conn_x",                     "uvlock": true } },
        {   "when": { "axis": "z", "north": "true" }, "apply": { "model": "soviet:block/structural/steel_pylon_horizontal_conn_z",                     "uvlock": true } },
        {   "when": { "axis": "z", "south": "true" }, "apply": { "model": "soviet:block/structural/steel_pylon_horizontal_conn_z", "y": 180,           "uvlock": true } },
        {   "when": { "axis": "z", "up":    "true" }, "apply": { "model": "soviet:block/structural/steel_pylon_horizontal_down",             "x": 180, "uvlock": true } },
        {   "when": { "axis": "z", "west":  "true" }, "apply": { "model": "soviet:block/structural/steel_pylon_horizontal_conn_x", "y": 180,           "uvlock": true } },
        {   "when": { "axis": "x"                  }, "apply": { "model": "soviet:block/structural/steel_pylon_horizontal",        "y": 90,            "uvlock": true } },
        {   "when": { "axis": "x", "down":  "true" }, "apply": { "model": "soviet:block/structural/steel_pylon_horizontal_down",   "y": 90,            "uvlock": true } },
        {   "when": { "axis": "x", "east":  "true" }, "apply": { "model": "soviet:block/structural/steel_pylon_horizontal_conn_z", "y": 90,            "uvlock": true } },
        {   "when": { "axis": "x", "north": "true" }, "apply": { "model": "soviet:block/structural/steel_pylon_horizontal_conn_x", "y": 270,           "uvlock": true } },
        {   "when": { "axis": "x", "south": "true" }, "apply": { "model": "soviet:block/structural/steel_pylon_horizontal_conn_x", "y": 90,            "uvlock": true } },
        {   "when": { "axis": "x", "up":    "true" }, "apply": { "model": "soviet:block/structural/steel_pylon_horizontal_down",   "y": 90,  "x": 180, "uvlock": true } },
        {   "when": { "axis": "x", "west":  "true" }, "apply": { "model": "soviet:block/structural/steel_pylon_horizontal_conn_z", "y": 270,           "uvlock": true } }
    ]
}
