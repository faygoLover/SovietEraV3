{
    "multipart": [
        {   "apply": { "model": "soviet:block/outerdeco/streetdeco/barb_wire" }},
        {   "when": { "north": "true" }, "apply": { "model": "soviet:block/outerdeco/streetdeco/barb_wire_side", "y": 180, "uvlock": true } },
        {   "when": { "east":  "true" }, "apply": { "model": "soviet:block/outerdeco/streetdeco/barb_wire_side", "y": 270, "uvlock": true } },
        {   "when": { "south": "true" }, "apply": { "model": "soviet:block/outerdeco/streetdeco/barb_wire_side",           "uvlock": true } },
        {   "when": { "west":  "true" }, "apply": { "model": "soviet:block/outerdeco/streetdeco/barb_wire_side", "y": 90,  "uvlock": true }
        }
    ]
}
