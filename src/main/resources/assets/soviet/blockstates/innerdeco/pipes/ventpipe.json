{
    "multipart": [
        {   "when": { "default": "true" }, "apply": { "model": "soviet:block/innerdeco/pipes/ventpipe"                                          } },
     	{   "when": { "down":    "true" }, "apply": { "model": "soviet:block/innerdeco/pipes/ventpipe_conn",           "y": 90,  "uvlock": true } },
     	{   "when": { "up":      "true" }, "apply": { "model": "soviet:block/innerdeco/pipes/ventpipe_conn", "x": 180, "y": 90,  "uvlock": true } },
        {   "when": { "north":   "true" }, "apply": { "model": "soviet:block/innerdeco/pipes/ventpipe_conn", "x": 270,           "uvlock": true } },
        {   "when": { "east":    "true" }, "apply": { "model": "soviet:block/innerdeco/pipes/ventpipe_conn", "x": 90,  "y": 270, "uvlock": true } },
        {   "when": { "south":   "true" }, "apply": { "model": "soviet:block/innerdeco/pipes/ventpipe_conn", "x": 90,            "uvlock": true } },
        {   "when": { "west":    "true" }, "apply": { "model": "soviet:block/innerdeco/pipes/ventpipe_conn", "x": 90,  "y": 90,  "uvlock": true } }
    ]
}
